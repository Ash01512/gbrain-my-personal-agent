{
  "name": "job-tracker-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker API and dashboard for the job-tracker Supabase database",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "./scripts/deploy.sh",
    "deploy:raw": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "migrate": "./scripts/migrate.sh",
    "smoke": "./scripts/smoke-test.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
